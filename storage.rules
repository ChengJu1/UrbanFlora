// Firebase Storage rules for UrbanFlora.
// Deploy with:  firebase deploy --only storage
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/observations/{obsId} {
      // Only the owner can read or write their own observation photos.
      // Limit uploads to reasonable JPEGs to curb abuse of the free tier.
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
