// Firestore security rules for UrbanFlora.
// Deploy with:  firebase deploy --only firestore:rules
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // A user can only touch their own profile document and sub-observations.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /observations/{obsId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Species catalog is read-only for clients; only admin tooling writes here.
    match /species/{scientificName} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Public sightings power the community map: every signed-in user can
    // read them, but only the owner can create / edit / delete their own.
    // The owner is identified by `ownerUid`, which must match the auth uid.
    match /public_sightings/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.ownerUid == request.auth.uid;
    }
  }
}
